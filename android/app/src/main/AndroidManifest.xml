<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Alarm and timer notifications, and the running timer / stopwatch notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms, granted at install (SCHEDULE_EXACT_ALARM is denied by default on Android 14+,
         and without exact alarms Android can delay a timer's notification by many minutes). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Live Updates: the running timer / stopwatch and a ringing alarm pinned at the top of the
         lock screen and the shade, and shown as a status-bar chip. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- While the app is open it rings an alarm itself (Ringer), vibrating as its channel would. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Alarms are set again after a restart (AlarmReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Native alarms (Alarms.java): wake-ups, Dismiss / Snooze, and setting them again
             after a restart or an app update. Not exported: only Android and the app reach it. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Todo widgets (docs/prd_todo_import_widgets.md): quick add and the filtered list. -->
        <activity
            android:name=".QuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/quick_add_title"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/WidgetDialog"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <activity
            android:name=".TodoWidgetActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".TodoWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/todo_widget_settings"
            android:taskAffinity=""
            android:theme="@style/WidgetDialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".QuickAddWidget"
            android:exported="false"
            android:label="@string/quick_add_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>

        <receiver
            android:name=".TodoListWidget"
            android:exported="false"
            android:label="@string/todo_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- The clock or zone changed: redraw (what is Now and today moved). Allowed implicit broadcasts. -->
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_todo_list_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
